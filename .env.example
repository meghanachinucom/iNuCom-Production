# Copy this file to .env and fill in strong, unique secrets before starting the server.
# NEVER commit .env to version control.

# Required: Password used to encrypt/decrypt production.db via SQLCipher
DB_PASSWORD=change-me-to-a-strong-database-password

# Required: Secret key for Flask session cookies and CSRF tokens
FLASK_SECRET_KEY=change-me-to-a-64-char-random-hex-string

# Optional: Set to 1 when serving behind HTTPS/TLS reverse proxy (e.g. Nginx)
HTTPS_ENABLED=0

# Optional: Directory where backup_db.py stores encrypted backups
BACKUP_DIR=./backups

# Optional: Database path (defaults to production.db)
DATABASE_PATH=production.db
